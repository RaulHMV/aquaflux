# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# firebase credentials (NUNCA subir al repo)
*firebase-adminsdk*.json
firebase-config.json
serviceAccountKey.json

# secrets y configuraciones sensibles
secrets/
*.key
*.pem
*.cert

# migration scripts con datos sensibles
migrations/*.local.sql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
